# ==============================================================================
# EMS (Education Management System) - Production Environment Configuration
# Sao chép tệp này thành .env trên VPS: cp .env.example .env
# ==============================================================================

# 1. Cơ Sở Dữ Liệu PostgreSQL
POSTGRES_USER=ems_admin
POSTGRES_PASSWORD=MatKhauBaoMatCucManh2026!@#
POSTGRES_DB=ems_production
DATABASE_PORT=5432

# Chuỗi kết nối Database cho Backend (lấy từ các thông số trên)
DATABASE_URL="postgresql://ems_admin:MatKhauBaoMatCucManh2026!@#@postgres:5432/ems_production?schema=public"

# 2. Cấu hình Backend API
NODE_ENV=production
PORT=8000
JWT_SECRET=ems_jwt_secret_key_random_64_characters_long_for_security_2026

# 3. Cấu hình VietQR Tự Động Tạo Mã Chuyển Khoản Học Phí
VIETQR_BANK_ID="970422"
VIETQR_ACCOUNT_NO="123456789"
VIETQR_ACCOUNT_NAME="TRUNG TAM TOAN TRI TUE SBR"

# 4. Cấu hình Frontend Web Client
# Nếu dùng tên miền riêng (ví dụ: https://ems.trungtam.vn):
VITE_API_URL=https://ems.trungtam.vn
# Nếu truy cập trực tiếp bằng IP của VPS:
# VITE_API_URL=http://DIA_CHI_IP_VPS:8000
